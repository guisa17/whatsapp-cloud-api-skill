# Copy to .env and fill in. NEVER commit the real file.
#
# Find these in developers.facebook.com → your app → "Connect with customers
# on WhatsApp" use case → Step 1: Try it.

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# Optional — App Secret lets the diagnostic check webhook field subscriptions
# (that endpoint requires an app token, not a user one).
WHATSAPP_APP_SECRET=

# Optional — to test the verification handshake end to end.
WHATSAPP_VERIFY_TOKEN=
WEBHOOK_URL=
